<Project>
  <!-- Copy to GamePaths.props (gitignored) and set your install path. -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Schedule I</GameDir>
    <!-- Set false to stop auto-copying built DLLs into the game's Mods folder. -->
    <CopyToGame>true</CopyToGame>
  </PropertyGroup>
</Project>
